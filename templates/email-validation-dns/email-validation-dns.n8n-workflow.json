{
  "name": "Email validation (DNS/MX) — webhook",
  "nodes": [
    {
      "id": "de635e7a-f03a-4465-89ab-be15ef46490e",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 288],
      "parameters": { "httpMethod": "GET", "path": "email-validation", "responseMode": "responseNode", "options": {} },
      "webhookId": "1795cf50-65bb-428e-9cfa-b6363b6dff85"
    },
    {
      "id": "719310cc-edbe-4da1-89df-b0e6779c9050",
      "name": "Prepare",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 288],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "asg-email", "name": "email", "value": "={{ ($json.query?.email ?? $json.body?.email ?? \"\").toString().trim() }}", "type": "string" },
            { "id": "asg-domain", "name": "domain", "value": "={{ (($json.query?.email ?? $json.body?.email ?? \"\").toString().split(\"@\")[1] ?? \"\").trim().toLowerCase() }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "d8764ed6-c8ca-497b-b2d1-f7f53bfe4070",
      "name": "Check syntax",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 288],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c-syntax", "leftValue": "={{ $json.email.includes(\"@\") && $json.domain.includes(\".\") }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true }, "rightValue": "" }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f47a2afd-21a5-4324-aaac-279b05ecd08f",
      "name": "Google DoH MX",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [672, 192],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "https://dns.google/resolve",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": { "parameters": [ { "name": "name", "value": "={{ $json.domain }}" }, { "name": "type", "value": "MX" } ] },
        "options": { "timeout": 5000 }
      }
    },
    {
      "id": "77f1c54c-95b4-4509-88ec-dd517324d942",
      "name": "Google has MX",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [896, 96],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c-gmx", "leftValue": "={{ $json.Answer }}", "operator": { "type": "array", "operation": "notEmpty", "singleValue": true }, "rightValue": "" }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "3fa5a10f-33ab-4845-b41a-229a4da41330",
      "name": "200 deliverable Google",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1120, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ ({ email: $('Prepare').item.json.email, valid: true, reason: \"mx_records\", dns_status: $json.Status, source: \"google\", checked_at: $now.toISO() }) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "ff7979da-b4c7-4c92-8b2e-742137baffa7",
